VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# API base URL
# Local example:  http://127.0.0.1:8000/api
# Production example: https://backened-core.onrender.com/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Deployment mode: "full" shows learners/instructors/courses + IQ.
# Set to "iq-only" to hide all learner/instructor/course CTAs and nav.
VITE_APP_MODE=full
